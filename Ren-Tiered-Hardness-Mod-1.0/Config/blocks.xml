<hardnessTieredMod>
	<!-- Patched by Osamu_Ren -->
		<!-- Three-Tier Ultra-Hard Steel Blocks -->
		<!-- Upgrade chain: stainlessSteel -> T1 -> T2 -> T3 via steelPolish (no new crafting) -->
	<append xpath="/blocks">

		<!-- ═══════════════════════════════ TIER 1 (30,000 HP) ═══════════════════════════════ -->
		<block name="hardSteelT1Master">
			<property name="CreativeMode" value="None"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="DescriptionKey" value="hardSteelT1BlockGroupDesc"/>
			<property name="Material" value="MhardSteelT1"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="PassThroughDamage" value="false"/>
			<property name="Texture" value="191"/>
			<property class="RepairItems">
				<property name="steelPolish" value="1"/>
			</property>
			<property name="UpgradeSound" value="place_block_metal"/>
			<drop event="Harvest" name="resourceScrapIron" count="15" tag="allHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="FilterTags" value="MC_building"/>
			<property name="SortOrder1" value="40p0"/>
			<property name="SortOrder2" value="0003"/>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="hardSteelT2Master"/>
				<property name="Item" value="steelPolish"/>
				<property name="ItemCount" value="2"/>
				<property name="UpgradeHitCount" value="2"/>
			</property>
		</block>
		<block name="hardSteelT1Shapes" shapes="All">
			<property name="DescriptionKey" value="hardSteelT1BlockGroupDesc"/>
			<property name="Material" value="MhardSteelT1_shapes"/>
			<property name="Shape" value="New"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="PassThroughDamage" value="false"/>
			<property name="Texture" value="191"/>
			<property name="UiBackgroundTexture" value="191"/>
			<property class="RepairItems">
				<property name="steelPolish" value="5"/>
			</property>
			<property name="UpgradeSound" value="place_block_metal"/>
			<drop event="Harvest" name="resourceScrapIron" count="15" tag="allHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="EconomicValue" value="160"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="FilterTags" value="MC_Shapes"/>
			<property name="SortOrder1" value="0011"/>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="hardSteelT2Shapes"/>
				<property name="Item" value="steelPolish"/>
				<property name="ItemCount" value="2"/>
				<property name="UpgradeHitCount" value="2"/>
			</property>
		</block>

		<!-- ═══════════════════════════════ TIER 2 (60,000 HP) ═══════════════════════════════ -->
		<block name="hardSteelT2Master">
			<property name="CreativeMode" value="None"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="DescriptionKey" value="hardSteelT2BlockGroupDesc"/>
			<property name="Material" value="MhardSteelT2"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="PassThroughDamage" value="false"/>
			<property name="Texture" value="191"/>
			<property class="RepairItems">
				<property name="steelPolish" value="1"/>
			</property>
			<property name="UpgradeSound" value="place_block_metal"/>
			<drop event="Harvest" name="resourceScrapIron" count="15" tag="allHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="FilterTags" value="MC_building"/>
			<property name="SortOrder1" value="40p0"/>
			<property name="SortOrder2" value="0004"/>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="hardSteelT3Master"/>
				<property name="Item" value="steelPolish"/>
				<property name="ItemCount" value="2"/>
				<property name="UpgradeHitCount" value="2"/>
			</property>
		</block>
		<block name="hardSteelT2Shapes" shapes="All">
			<property name="DescriptionKey" value="hardSteelT2BlockGroupDesc"/>
			<property name="Material" value="MhardSteelT2_shapes"/>
			<property name="Shape" value="New"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="PassThroughDamage" value="false"/>
			<property name="Texture" value="191"/>
			<property name="UiBackgroundTexture" value="191"/>
			<property class="RepairItems">
				<property name="steelPolish" value="5"/>
			</property>
			<property name="UpgradeSound" value="place_block_metal"/>
			<drop event="Harvest" name="resourceScrapIron" count="15" tag="allHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="EconomicValue" value="160"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="FilterTags" value="MC_Shapes"/>
			<property name="SortOrder1" value="0012"/>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="hardSteelT3Shapes"/>
				<property name="Item" value="steelPolish"/>
				<property name="ItemCount" value="2"/>
				<property name="UpgradeHitCount" value="2"/>
			</property>
		</block>

		<!-- ═══════════════════════════════ TIER 3 (120,000 HP) ═══════════════════════════════ -->
		<block name="hardSteelT3Master">
			<property name="CreativeMode" value="None"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="DescriptionKey" value="hardSteelT3BlockGroupDesc"/>
			<property name="Material" value="MhardSteelT3"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="PassThroughDamage" value="false"/>
			<property name="Texture" value="191"/>
			<property class="RepairItems">
				<property name="steelPolish" value="1"/>
			</property>
			<property name="UpgradeSound" value="place_block_metal"/>
			<drop event="Harvest" name="resourceScrapIron" count="15" tag="allHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="FilterTags" value="MC_building"/>
			<property name="SortOrder1" value="40p0"/>
			<property name="SortOrder2" value="0005"/>
		</block>
		<block name="hardSteelT3Shapes" shapes="All">
			<property name="DescriptionKey" value="hardSteelT3BlockGroupDesc"/>
			<property name="Material" value="MhardSteelT3_shapes"/>
			<property name="Shape" value="New"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="PassThroughDamage" value="false"/>
			<property name="Texture" value="191"/>
			<property name="UiBackgroundTexture" value="191"/>
			<property class="RepairItems">
