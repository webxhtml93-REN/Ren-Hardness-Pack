			<property name="EconomicValue" value="160"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="FilterTags" value="MC_Shapes"/>
			<property name="SortOrder1" value="0013"/>
		</block>

	</append>

	<!-- Hook T1 onto the end of the stainlessSteel upgrade chain (from Ren-Hardness-Mod) -->
	<append xpath="/blocks/block[@name='stainlessSteelMaster']">
		<property class="UpgradeBlock">
			<property name="ToBlock" value="hardSteelT1Master"/>
			<property name="Item" value="steelPolish"/>
			<property name="ItemCount" value="2"/>
			<property name="UpgradeHitCount" value="2"/>
		</property>
	</append>
	<append xpath="/blocks/block[@name='stainlessSteelShapes']">
		<property class="UpgradeBlock">
			<property name="ToBlock" value="hardSteelT1Shapes"/>
			<property name="Item" value="steelPolish"/>
			<property name="ItemCount" value="2"/>
			<property name="UpgradeHitCount" value="2"/>
		</property>
	</append>

</hardnessTieredMod>
